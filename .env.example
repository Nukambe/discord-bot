HEROKU_API_KEY=
HEROKU_APP_NAME=

# Chrome used for the Monopoly GO wiki fetch. Unset = the Heroku buildpack path
# and headless mode. On a home PC, point CHROME_PATH at the local install and
# set CHROME_HEADLESS=false — Cloudflare challenges headless Chrome regardless
# of the source IP, so the fetch only clears when running headed.
# e.g. CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_PATH=
CHROME_HEADLESS=

CLIENT_ID=
DISCORD_TOKEN=
GUILD_ID=
CHANNEL_ID=
GIFT_ROTATION_CHANNEL_ID=

ROLLER_CHANNEL_ID=
WRECKER_CHANNEL_ID=
BUILDER_CHANNEL_ID=
COLLECTOR_CHANNEL_ID=
ANCHOR_CHANNEL_ID=
OLY_CHANNEL_ID=
MECH_CHANNEL_ID=
MAJESTIC_CHANNEL_ID=
GAMER_CHANNEL_ID=
TEST_CHANNEL_ID=
IMG_CHANNEL_ID=
FORTUNE_FLIP_CHANNEL_ID=

ROLLER_USER_ID=
WRECKER_USER_ID=
BUILDER_USER_ID=
COLLECTOR_USER_ID=
ANCHOR_USER_ID=
GAMER_USER_ID=

TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_REFRESH=
TWITCH_CHANNEL=nukambe

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Local-only overlay window (OBS capture), defaults to 5183 if unset
OVERLAY_PORT=

# Now Playing panel (Spotify). Create an app at
# https://developer.spotify.com/dashboard with redirect URI
# http://127.0.0.1:8888/callback, then run `npm run spotify:auth` once to
# obtain SPOTIFY_REFRESH. Leave all three unset to skip the panel (no crash).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH=

# --- Twitch Extension: in-game item tooltips (apps/twitchext) ---
# Kuroko's Basketball: Street Rivals, read out of an Android emulator.
# Everything runs on this machine; nothing is deployed.
#
# Values from https://dev.twitch.tv/console/extensions -> your extension.
# TWITCHEXT_SECRET is the base64 "Extension Secret", not the client secret.
TWITCHEXT_CLIENT_ID=
TWITCHEXT_SECRET=
# Your Twitch user id (the extension owner). Required for PubSub broadcasts.
TWITCHEXT_OWNER_ID=
# Numeric channel id the companion posts for. Not the login name.
TWITCHEXT_CHANNEL_ID=

# Shared secret between the companion app and the EBS. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWITCHEXT_COMPANION_SECRET=

# Where the companion posts and the packaged frontend calls. Defaults to
# loopback. Remote viewers cannot reach loopback -- their browser resolves it to
# their own machine -- so point this at a tunnel (cloudflared, ngrok) before
# going live, and add that host to the extension's URL fetching allowlist.
TWITCHEXT_EBS_URL=http://127.0.0.1:8080

# EBS bind address and port. Keep the host on loopback unless you have a reason:
# 0.0.0.0 exposes your game state to everything on the local network.
TWITCHEXT_HOST=127.0.0.1
TWITCHEXT_PORT=8080
# Developer-rig localhost origins are allowed by default; set false to lock down.
TWITCHEXT_ALLOW_LOCAL=
# PubSub is a ~1/s nudge, not the main feed. Set false to run poll-only.
TWITCHEXT_PUBSUB=

# Companion tuning. Raising FPS costs CPU and adb bandwidth; 4 is plenty.
ADB_PATH=
TWITCHEXT_ADB_SERIAL=
TWITCHEXT_CAPTURE_FPS=4
# Match confidence floor, and how far ahead of the runner-up a match must be.
TWITCHEXT_MIN_SCORE=0.86
TWITCHEXT_MIN_MARGIN=0.03
# Frames a slot must agree with itself before publishing (anti-flicker).
TWITCHEXT_STABILITY=3
